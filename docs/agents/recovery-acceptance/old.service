[Unit]
Description=Encrypted verified database backup for notes-production
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
UMask=0077\
		 nExecStart=/usr/bin/python3 /var/lib/leptoskit/notes-production/control/recovery.py backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict\
		 nReadWritePaths=/var/lib/leptoskit/notes-production/control /run/docker.sock
