# eu/growth/addons/30-certificates-11.yaml
{
  "apiVersion": "cert-manager.io/v1",
  "kind": "ClusterIssuer",
  "metadata": {
    "name": "apps"
  },
  "spec": {
    "acme": {
      "email": "operator@example.com",
      "privateKeySecretRef": {
        "name": "apps-acme-account"
      },
      "server": "https://acme-v02.api.letsencrypt.org/directory",
      "solvers": [
        {
          "dns01": {
            "cloudflare": {
              "apiTokenSecretRef": {
                "key": "api-token",
                "name": "cloudflare-dns"
              }
            }
          }
        }
      ]
    }
  }
}
---
# eu/growth/addons/30-certificates-12.yaml
{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "apps-wildcard",
    "namespace": "kube-system"
  },
  "spec": {
    "dnsNames": [
      "*.apps.example.com"
    ],
    "issuerRef": {
      "kind": "ClusterIssuer",
      "name": "apps"
    },
    "secretName": "apps-wildcard-tls"
  }
}
---
# eu/growth/addons/30-certificates-13.yaml
{
  "apiVersion": "traefik.io/v1alpha1",
  "kind": "TLSStore",
  "metadata": {
    "name": "default",
    "namespace": "kube-system"
  },
  "spec": {
    "defaultCertificate": {
      "secretName": "apps-wildcard-tls"
    }
  }
}
---
# eu/growth/addons/30-database-16.yaml
{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "Cluster",
  "metadata": {
    "name": "shared",
    "namespace": "database"
  },
  "spec": {
    "affinity": {
      "nodeSelector": {
        "leptoskit.dev/pool": "platform"
      },
      "podAntiAffinityType": "preferred",
      "tolerations": [
        {
          "effect": "PreferNoSchedule",
          "key": "leptoskit.dev/pool",
          "operator": "Equal",
          "value": "platform"
        }
      ]
    },
    "backup": {
      "barmanObjectStore": {
        "destinationPath": "s3://example-backups/eu/growth",
        "endpointURL": "https://s3.example.com",
        "s3Credentials": {
          "accessKeyId": {
            "key": "ACCESS_KEY_ID",
            "name": "object-storage"
          },
          "secretAccessKey": {
            "key": "SECRET_ACCESS_KEY",
            "name": "object-storage"
          }
        },
        "wal": {
          "compression": "gzip"
        }
      },
      "retentionPolicy": "30d"
    },
    "instances": 1,
    "storage": {
      "size": "100Gi",
      "storageClass": "local-path"
    }
  }
}
---
# eu/growth/addons/30-database-17.yaml
{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "ScheduledBackup",
  "metadata": {
    "name": "shared-daily",
    "namespace": "database"
  },
  "spec": {
    "backupOwnerReference": "self",
    "cluster": {
      "name": "shared"
    },
    "method": "barmanObjectStore",
    "schedule": "0 0 2 * * *"
  }
}
---
# eu/growth/addons/40-tunnel-14.yaml
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "cloudflared",
    "namespace": "kube-system"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "cloudflared"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "cloudflared"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "tunnel",
              "--no-autoupdate",
              "run"
            ],
            "env": [
              {
                "name": "TUNNEL_TOKEN",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "token",
                    "name": "cloudflare-tunnel"
                  }
                }
              }
            ],
            "image": "cloudflare/cloudflared:2026.11.0",
            "name": "cloudflared"
          }
        ],
        "nodeSelector": {
          "leptoskit.dev/pool": "platform"
        },
        "tolerations": [
          {
            "effect": "PreferNoSchedule",
            "key": "leptoskit.dev/pool",
            "operator": "Equal",
            "value": "platform"
          }
        ]
      }
    }
  }
}
