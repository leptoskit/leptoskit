# eu/growth/addons/21-http-08.yaml
{
  "apiVersion": "helm.cattle.io/v1",
  "kind": "HelmChart",
  "metadata": {
    "name": "http",
    "namespace": "kube-system"
  },
  "spec": {
    "chart": "keda-add-ons-http",
    "repo": "https://kedacore.github.io/charts",
    "targetNamespace": "keda",
    "valuesContent": "{\n  \"interceptor\": {\n    \"directPodRouting\": false,\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  },\n  \"operator\": {\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  },\n  \"scaler\": {\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  }\n}",
    "version": "0.16.0"
  }
}
