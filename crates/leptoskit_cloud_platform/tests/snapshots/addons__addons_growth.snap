  },
  "spec": {
    "chart": "cloudnative-pg",
    "repo": "https://cloudnative-pg.github.io/charts",
    "targetNamespace": "cnpg-system",
    "valuesContent": "{\n  \"nodeSelector\": {\n    \"leptoskit.dev/pool\": \"platform\"\n  },\n  \"tolerations\": [\n    {\n      \"effect\": \"PreferNoSchedule\",\n      \"key\": \"leptoskit.dev/pool\",\n      \"operator\": \"Equal\",\n      \"value\": \"platform\"\n    }\n  ]\n}",
    "version": "0.29.2"
  }
}
