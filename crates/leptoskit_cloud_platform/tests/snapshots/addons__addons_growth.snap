  },
  "spec": {
    "chart": "keda",
    "repo": "https://kedacore.github.io/charts",
    "targetNamespace": "keda",
    "valuesContent": "{\n  \"metricsServer\": {\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  },\n  \"nodeSelector\": {\n    \"leptoskit.dev/pool\": \"platform\"\n  },\n  \"operator\": {\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  },\n  \"tolerations\": [\n    {\n      \"effect\": \"PreferNoSchedule\",\n      \"key\": \"leptoskit.dev/pool\",\n      \"operator\": \"Equal\",\n      \"value\": \"platform\"\n    }\n  ],\n  \"webhooks\": {\n    \"nodeSelector\": {\n      \"leptoskit.dev/pool\": \"platform\"\n    },\n    \"tolerations\": [\n      {\n        \"effect\": \"PreferNoSchedule\",\n        \"key\": \"leptoskit.dev/pool\",\n        \"operator\": \"Equal\",\n        \"value\": \"platform\"\n      }\n    ]\n  }\n}",
    "version": "2.21.1"
  }
