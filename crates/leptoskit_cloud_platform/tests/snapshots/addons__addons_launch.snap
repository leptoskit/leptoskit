# eu/launch/addons/20-charts-11.yaml
{
  "apiVersion": "helm.cattle.io/v1",
  "kind": "HelmChart",
  "metadata": {
    "name": "zot",
    "namespace": "kube-system"
  },
  "spec": {
    "chart": "zot",
    "repo": "https://zotregistry.dev/helm-charts",
    "targetNamespace": "registry",
    "valuesContent": "{\n  \"configFiles\": {\n    \"config.json\": \"{\\n  \\\"distSpecVersion\\\": \\\"1.1.1\\\",\\n  \\\"http\\\": {\\n    \\\"address\\\": \\\"0.0.0.0\\\",\\n    \\\"auth\\\": {\\n      \\\"htpasswd\\\": {\\n        \\\"path\\\": \\\"/auth/htpasswd\\\"\\n      }\\n    },\\n    \\\"port\\\": \\\"5000\\\"\\n  },\\n  \\\"log\\\": {\\n    \\\"level\\\": \\\"info\\\"\\n  },\\n  \\\"storage\\\": {\\n    \\\"dedupe\\\": false,\\n    \\\"rootDirectory\\\": \\\"/var/lib/registry\\\",\\n    \\\"storageDriver\\\": {\\n      \\\"bucket\\\": \\\"example-registry\\\",\\n      \\\"forcepathstyle\\\": true,\\n      \\\"name\\\": \\\"s3\\\",\\n      \\\"region\\\": \\\"example-region\\\",\\n      \\\"regionendpoint\\\": \\\"https://s3.example.com\\\",\\n      \\\"secure\\\": true,\\n      \\\"skipverify\\\": false\\n    }\\n  }\\n}\"\n  },\n  \"env\": [\n    {\n      \"name\": \"AWS_ACCESS_KEY_ID\",\n      \"valueFrom\": {\n        \"secretKeyRef\": {\n          \"key\": \"ACCESS_KEY_ID\",\n          \"name\": \"object-storage\"\n        }\n      }\n    },\n    {\n      \"name\": \"AWS_SECRET_ACCESS_KEY\",\n      \"valueFrom\": {\n        \"secretKeyRef\": {\n          \"key\": \"SECRET_ACCESS_KEY\",\n          \"name\": \"object-storage\"\n        }\n      }\n    }\n  ],\n  \"externalSecrets\": [\n    {\n      \"mountPath\": \"/auth\",\n      \"secretName\": \"registry-auth\"\n    }\n  ],\n  \"fullnameOverride\": \"zot\",\n  \"mountConfig\": true,\n  \"nodeSelector\": {\n    \"leptoskit.dev/pool\": \"tenant\"\n  },\n  \"persistence\": true,\n  \"pvc\": {\n    \"storageClassName\": \"local-path\"\n  },\n  \"service\": {\n    \"port\": 5000,\n    \"type\": \"ClusterIP\"\n  },\n  \"tolerations\": [\n    {\n      \"effect\": \"PreferNoSchedule\",\n      \"key\": \"leptoskit.dev/pool\",\n      \"operator\": \"Equal\",\n      \"value\": \"tenant\"\n    }\n  ]\n}",
    "version": "0.1.134"
  }
}
