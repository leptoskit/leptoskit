# eu/launch/addons/30-database-20.yaml
{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "Cluster",
  "metadata": {
    "name": "shared",
    "namespace": "database"
  },
  "spec": {
    "affinity": {
      "nodeSelector": {
        "leptoskit.dev/pool": "tenant"
      },
      "podAntiAffinityType": "preferred",
      "tolerations": [
        {
          "effect": "PreferNoSchedule",
          "key": "leptoskit.dev/pool",
          "operator": "Equal",
          "value": "tenant"
        }
      ]
    },
    "backup": {
      "barmanObjectStore": {
        "destinationPath": "s3://example-backups/eu/launch",
        "endpointURL": "https://s3.example.com",
        "s3Credentials": {
          "accessKeyId": {
            "key": "ACCESS_KEY_ID",
            "name": "object-storage"
          },
          "secretAccessKey": {
            "key": "SECRET_ACCESS_KEY",
            "name": "object-storage"
          }
        },
        "wal": {
          "compression": "gzip"
        }
      },
      "retentionPolicy": "30d"
    },
    "env": [
      {
        "name": "AWS_DEFAULT_REGION",
        "value": "example-region"
      }
    ],
    "instances": 1,
    "storage": {
      "size": "100Gi",
      "storageClass": "local-path"
    }
  }
}
---
# eu/launch/addons/30-database-21.yaml
{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "ScheduledBackup",
  "metadata": {
    "name": "shared-daily",
    "namespace": "database"
  },
  "spec": {
    "backupOwnerReference": "self",
    "cluster": {
      "name": "shared"
    },
    "method": "barmanObjectStore",
    "schedule": "0 0 2 * * *"
  }
}
---
# eu/launch/addons/30-registry-12.yaml
{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "registry",
    "namespace": "registry"
  },
  "spec": {
    "dnsNames": [
      "registry.apps.example.com"
    ],
    "issuerRef": {
      "kind": "ClusterIssuer",
      "name": "apps"
    },
    "secretName": "registry-tls"
  }
}
---
# eu/launch/addons/30-registry-13.yaml
{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "registry",
    "namespace": "registry"
  },
  "spec": {
    "ingressClassName": "traefik",
    "rules": [
      {
        "host": "registry.apps.example.com",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "zot",
                  "port": {
                    "number": 5000
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      }
    ],
    "tls": [
      {
        "hosts": [
          "registry.apps.example.com"
        ],
        "secretName": "registry-tls"
      }
    ]
  }
}
---
# eu/launch/addons/40-tunnel-18.yaml
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "cloudflared",
    "namespace": "kube-system"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "cloudflared"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "cloudflared"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "tunnel",
              "--no-autoupdate",
              "run"
            ],
            "env": [
              {
                "name": "TUNNEL_TOKEN",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "token",
                    "name": "cloudflare-tunnel"
                  }
                }
              }
            ],
            "image": "cloudflare/cloudflared:2026.11.0",
            "name": "cloudflared"
          }
        ],
        "nodeSelector": {
          "leptoskit.dev/pool": "tenant"
        },
        "tolerations": [
          {
            "effect": "PreferNoSchedule",
            "key": "leptoskit.dev/pool",
            "operator": "Equal",
            "value": "tenant"
          }
        ]
      }
    }
  }
}
