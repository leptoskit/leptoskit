{
  "apiVersion": "v1",
  "data": {
    "requirements.json": "[\n  {\n    \"createdBy\": \"operator\",\n    \"keys\": [\n      \"ACCESS_KEY_ID\",\n      \"SECRET_ACCESS_KEY\"\n    ],\n    \"name\": \"object-storage\",\n    \"namespace\": \"database\",\n    \"purpose\": \"WAL archives and base backups\",\n    \"source\": {\n      \"access_key\": \"ACCESS_KEY_ID\",\n      \"kind\": \"kubernetes-secret\",\n      \"name\": \"object-storage\",\n      \"secret_key\": \"SECRET_ACCESS_KEY\"\n    }\n  },\n  {\n    \"createdBy\": \"operator\",\n    \"keys\": [\n      \"htpasswd\"\n    ],\n    \"name\": \"registry-auth\",\n    \"namespace\": \"registry\",\n    \"purpose\": \"Authenticated registry push and pull\",\n    \"source\": \"operator bcrypt htpasswd file\"\n  },\n  {\n    \"createdBy\": \"operator\",\n    \"keys\": [\n      \"ACCESS_KEY_ID\",\n      \"SECRET_ACCESS_KEY\"\n    ],\n    \"name\": \"object-storage\",\n    \"namespace\": \"registry\",\n    \"purpose\": \"Registry S3 storage\",\n    \"source\": {\n      \"access_key\": \"ACCESS_KEY_ID\",\n      \"kind\": \"kubernetes-secret\",\n      \"name\": \"object-storage\",\n      \"secret_key\": \"SECRET_ACCESS_KEY\"\n    }\n  },\n  {\n    \"createdBy\": \"cert-manager\",\n    \"keys\": [\n      \"tls.crt\",\n      \"tls.key\"\n    ],\n    \"name\": \"registry-tls\",\n    \"namespace\": \"registry\",\n    \"purpose\": \"Registry TLS\",\n    \"source\": \"Certificate registry\"\n  },\n  {\n    \"createdBy\": \"operator\",\n    \"keys\": [\n      \"api-token\"\n    ],\n    \"name\": \"cloudflare-dns\",\n    \"namespace\": \"cert-manager\",\n    \"purpose\": \"DNS-01 challenge\",\n    \"source\": \"Cloudflare token with zone DNS edit and zone read\"\n  },\n  {\n    \"createdBy\": \"cert-manager\",\n    \"keys\": [\n      \"tls.key\"\n    ],\n    \"name\": \"apps-acme-account\",\n    \"namespace\": \"cert-manager\",\n    \"purpose\": \"ACME account key\",\n    \"source\": \"cert-manager generates this; do not precreate\"\n  },\n  {\n    \"createdBy\": \"cert-manager\",\n    \"keys\": [\n      \"tls.crt\",\n      \"tls.key\"\n    ],\n    \"name\": \"apps-wildcard-tls\",\n    \"namespace\": \"kube-system\",\n    \"purpose\": \"Ingress default wildcard certificate\",\n    \"source\": \"Certificate apps-wildcard generates this; do not precreate\"\n  },\n  {\n    \"createdBy\": \"operator\",\n    \"keys\": [\n      \"token\"\n    ],\n    \"name\": \"cloudflare-tunnel\",\n    \"namespace\": \"kube-system\",\n    \"purpose\": \"Tunnel connector\",\n    \"source\": \"sensitive OpenTofu tunnel_token output\"\n  }\n]"
  },
  "kind": "ConfigMap",
  "metadata": {
    "name": "required-secrets",
    "namespace": "kube-system"
  }
}
