---
source: crates/leptoskit_cloud_runtime/tests/manifests.rs
expression: as_yaml(&objects)
---
apiVersion: v1
kind: Namespace
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
  name: lk-0b64f478d99c825f63ac
---
apiVersion: v1
kind: ResourceQuota
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: quota
  namespace: lk-0b64f478d99c825f63ac
spec:
  hard:
    limits.cpu: 1000m
    limits.memory: 256Mi
    pods: '2'
    requests.cpu: 1000m
    requests.memory: 256Mi
    requests.storage: 1Gi
---
apiVersion: v1
kind: LimitRange
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: limits
  namespace: lk-0b64f478d99c825f63ac
spec:
  limits:
  - max:
      cpu: 1000m
      memory: 256Mi
    type: Container
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: default-deny
  namespace: lk-0b64f478d99c825f63ac
spec:
  egress: []
  ingress: []
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: allow-same-namespace
  namespace: lk-0b64f478d99c825f63ac
spec:
  egress:
  - to:
    - podSelector: {}
  ingress:
  - from:
    - podSelector: {}
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    app.kubernetes.io/name: app
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: allow-from-ingress-app
  namespace: lk-0b64f478d99c825f63ac
spec:
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: keda
      podSelector:
        matchLabels:
          app.kubernetes.io/component: interceptor
          app.kubernetes.io/name: http-add-on
    ports:
    - port: 8080
      protocol: TCP
  podSelector:
    matchLabels:
      app.kubernetes.io/name: app
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: allow-dns
  namespace: lk-0b64f478d99c825f63ac
spec:
  egress:
  - ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
    to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
  podSelector: {}
  policyTypes:
  - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: allow-internet
  namespace: lk-0b64f478d99c825f63ac
spec:
  egress:
  - to:
    - ipBlock:
        cidr: 0.0.0.0/0
        except:
        - 10.0.0.0/8
        - 169.254.0.0/16
        - 192.168.0.0/16
  podSelector: {}
  policyTypes:
  - Egress
---
apiVersion: v1
kind: ServiceAccount
automountServiceAccountToken: false
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: app
  namespace: lk-0b64f478d99c825f63ac
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: app
  namespace: lk-0b64f478d99c825f63ac
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: app
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: leptoskit-cloud
        app.kubernetes.io/name: app
        leptoskit.cloud/deployment: '1'
        leptoskit.cloud/environment: production
        leptoskit.cloud/organization: acme
        leptoskit.cloud/project: notes
    spec:
      automountServiceAccountToken: false
      containers:
      - command:
        - /app/server
        env:
        - name: RUST_LOG
          value: info
        image: ghcr.io/acme/notes@sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8080
            scheme: HTTP
          initialDelaySeconds: 10
          periodSeconds: 10
        name: app
        ports:
        - containerPort: 8080
          protocol: TCP
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8080
            scheme: HTTP
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          limits:
            cpu: 500m
            memory: 128Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /tmp
          name: tmp
      runtimeClassName: gvisor
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: app
      terminationGracePeriodSeconds: 30
      volumes:
      - emptyDir: {}
        name: tmp
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: app
  namespace: lk-0b64f478d99c825f63ac
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: 8080
  selector:
    app.kubernetes.io/name: app
  type: ClusterIP
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: http-interceptor
  namespace: lk-0b64f478d99c825f63ac
spec:
  externalName: keda-add-ons-http-interceptor-proxy.keda.svc.cluster.local
  ports:
  - port: 8080
  type: ExternalName
---
apiVersion: http.keda.sh/v1beta1
kind: InterceptorRoute
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: app
  namespace: lk-0b64f478d99c825f63ac
spec:
  target:
    service: app
    port: 80
  rules:
  - hosts:
    - notes.leptoskit.app
    paths:
    - value: /
  scalingMetric:
    concurrency:
      targetValue: 100
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: app
  namespace: lk-0b64f478d99c825f63ac
spec:
  scaleTargetRef:
    name: app
    apiVersion: apps/v1
    kind: Deployment
  minReplicaCount: 0
  maxReplicaCount: 1
  triggers:
  - type: external-push
    metadata:
      interceptorRoute: app
      scalerAddress: keda-add-ons-http-external-scaler.keda.svc.cluster.local:9090
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  labels:
    app.kubernetes.io/managed-by: leptoskit-cloud
    leptoskit.cloud/deployment: '1'
    leptoskit.cloud/environment: production
    leptoskit.cloud/organization: acme
    leptoskit.cloud/project: notes
  name: notes.leptoskit.app
  namespace: lk-0b64f478d99c825f63ac
spec:
  ingressClassName: nginx
  rules:
  - host: notes.leptoskit.app
    http:
      paths:
      - backend:
          service:
            name: http-interceptor
            port:
              number: 8080
        path: /
        pathType: Prefix
  tls:
  - hosts:
    - notes.leptoskit.app
    secretName: leptoskit-wildcard-tls
