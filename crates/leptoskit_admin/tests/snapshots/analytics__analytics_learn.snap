      "Your first typed event"
      "NoteCreated arrived 11 times, typed"
      "4 min"
    a [lesson:reading-a-trend] label="Reading a trend: done" href=/_leptoskit/admin/learn/analytics/reading-a-trend
      "✓"
      "Reading a trend"
      "You saved “Notes, weekly”"
      "4 min"
    a [lesson:building-a-funnel] label="Building a funnel: to do" href=/_leptoskit/admin/learn/analytics/building-a-funnel
      "○"
      "Building a funnel"
      "Check: you saved a funnel of three steps or more"
      "5 min"
    a [lesson:retention-honestly] label="Retention, honestly: to do" href=/_leptoskit/admin/learn/analytics/retention-honestly
      "○"
      "Retention, honestly"
      "Check: you saved a retention grid"
      "4 min"
    a [lesson:who-are-these-people] label="Who are these people?: done" href=/_leptoskit/admin/learn/analytics/who-are-these-people
      "✓"
      "Who are these people?"
      "member-0N@notes.example's anonymous visits and account are one person"
      "3 min"
    a [lesson:sql-when-you-need-it] label="SQL when you need it: to do" href=/_leptoskit/admin/learn/analytics/sql-when-you-need-it
      "○"
      "SQL when you need it"
      "Check: you read a query's SQL in its Workings"
      "3 min"
    "Infrastructure"
    "1/5"
