aside [drawer-aside] label="Workings"
  div [drawer:web] label="Workings: Web overview · 5 Oct – 1 Nov · live"
    "Workings"
    "Web overview · 5 Oct – 1 Nov · live"
    button [workings-close] label="Close workings (W)"
      "Close"
    div [station:emit]
      "Emit"
      "sent by the analytics client"
      "$pageview"
      "is one of the client's own events: the web client sends it by itself, with the properties below, once"
      "web::init"
      "runs."
      div [code]
        div [code-line]
          "1"
          span [code-text]
            "$current_url"
            ":"
            "string"
        div [code-line]
          "2"
          span [code-text]
            "$pathname"
            ":"
            "string"
        div [code-line]
          "3"
          span [code-text]
            "$referrer"
            ":"
            "string"
        button [copy] label="Copy as text"
          "Copy"
    div [station:send]
      "Send"
      "the latest $pageview, re-encoded here"
      "Without a type the names travel with every event: 105 bytes in the binary format, 282 as JSON. Measured as one event alone in a batch."
      div [code]
        div [code-line]
          "1"
          span [code-text]
            "binary"
            ","
            "named"
            "105"
            "bytes"
        div [code-line]
          "2"
          span [code-text]
            "JSON"
            ","
            "named"
            "282"
            "bytes"
        button [copy] label="Copy as text"
          "Copy"
    div [station:store]
      "Store"
      "events, person_distinct_ids, person_overrides, sessions on sqlite"
      "Events land in"
      "events"
      "as they arrive; sessions and persons are kept up to date beside them as each batch is stored, so a query reads tables, never a queue. These are the ones this query read."
      div [code]
        div [code-line]
          "1"
          span [code-text]
            "events"
        div [code-line]
          "2"
          span [code-text]
            "uuid"
            "BLOB"
        div [code-line]
          "3"
          span [code-text]
            "name"
            "TEXT"
        div [code-line]
          "4"
          span [code-text]
            "distinct_id"
            "TEXT"
        div [code-line]
          "5"
          span [code-text]
            "person_id"
            "BLOB"
        div [code-line]
          "6"
          span [code-text]
            "timestamp"
            "TEXT"
        div [code-line]
          "7"
          span [code-text]
            "received_at"
            "TEXT"
        div [code-line]
          "8"
          span [code-text]
            "session_id"
            "BLOB"
        div [code-line]
          "9"
          span [code-text]
            "context_id"
            "INTEGER"
        div [code-line]
          "10"
          span [code-text]
            "properties"
            "TEXT"
        div [code-line]
          "11"
          span [code-text]
            "source"
            "INTEGER"
        div [code-line]
          "12"
          span [code-text]
        div [code-line]
          "13"
          span [code-text]
            "person_distinct_ids"
        div [code-line]
          "14"
          span [code-text]
            "distinct_id"
            "TEXT"
        div [code-line]
          "15"
          span [code-text]
            "person_id"
            "BLOB"
        div [code-line]
          "16"
          span [code-text]
