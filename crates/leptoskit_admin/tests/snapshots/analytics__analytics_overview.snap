---
source: crates/leptoskit_admin/tests/analytics.rs
expression: screen(html)
---
main [main]
  div [notice] role=status
  div [live-refresh]
    "Web analytics"
    "every site gets this without setup · sessions average 1m 00s · updates live"
    button [add-to-dashboard]
      "Add to dashboard"
    div [filters]
      a label="Last 7 days" href=/_leptoskit/admin/analytics/overview?compare=1&amp;days=7&amp;from=2026-10-05&amp;to=2026-11-02
        "Last 7 days"
      a label="Last 30 days" href=/_leptoskit/admin/analytics/overview?compare=1&amp;days=30&amp;from=2026-10-05&amp;to=2026-11-02
        "Last 30 days"
      a label="Last 90 days" href=/_leptoskit/admin/analytics/overview?compare=1&amp;days=90&amp;from=2026-10-05&amp;to=2026-11-02
        "Last 90 days"
      a label="Compare previous period" href=/_leptoskit/admin/analytics/overview?compare=0&amp;from=2026-10-05&amp;to=2026-11-02 current=page
        "Compare"
        "previous period"
    div [grid-tiles]
      div [stat:visitors]
        "Visitors"
        button [workings-tab:web] label="Show workings: $pageview → WebOverview"
          div [mint-piece]
          "Workings"
          span [mint-source]
            "$pageview → WebOverview"
        span [stat-value]
          "10"
        <vector>
        "Nothing in the period before to compare"
      div [stat:pageviews]
        "Pageviews"
        button [workings-tab:web] label="Show workings: $pageview → WebOverview"
          div [mint-piece]
          "Workings"
          span [mint-source]
            "$pageview → WebOverview"
        span [stat-value]
          "20"
        <vector>
        "Nothing in the period before to compare"
      div [stat:sessions]
        "Sessions"
        button [workings-tab:web] label="Show workings: sessions → WebOverview"
          div [mint-piece]
          "Workings"
          span [mint-source]
            "sessions → WebOverview"
        span [stat-value]
          "10"
        <vector>
        "Nothing in the period before to compare"
      div [stat:bounce-rate]
        "Bounce rate"
        button [workings-tab:web] label="Show workings: sessions.is_bounce"
          div [mint-piece]
          "Workings"
          span [mint-source]
            "sessions.is_bounce"
        span [stat-value]
          "0.0%"
        "No daily series yet"
        "Nothing in the period before to compare"
    div [grid-main]
      div [visitors-card]
        "Visitors over time"
        "daily"
        button [workings-tab:visitors] label="Show workings: $pageview → Trends"
          div [mint-piece]
          "Workings"
          span [mint-source]
            "$pageview → Trends"
        div [trend-chart] role=img label="$pageview, 5 Oct – 1 Nov over time"
          "Visitors"
          "4"
          "3"
          "2"
          "1"
          "0"
          <vector>
          <vector>
          <vector>
          div [chart-points]
            a [chart-point] label="Show the people behind 5 Oct" href=/_leptoskit/admin/analytics/actors?back=%2F_leptoskit%2Fadmin%2Fanalytics%2Foverview%3Fcompare%3D1%26from%3D2026-10-05%26to%3D2026-11-02&amp;q=%7B%22query%22%3A%7B%22kind%22%3A%22trends%22%2C%22range%22%3A%7B%22from%22%3A%222026-10-05T00%3A00%3A00Z%22%2C%22to%22%3A%222026-11-02T00%3A00%3A00Z%22%7D%2C%22interval%22%3A%22day%22%2C%22series%22%3A%5B%7B%22event%22%3A%22%24pageview%22%7D%5D%2C%22math%22%3A%22unique_persons%22%2C%22compare%22%3Atrue%7D%2C%22point%22%3A%7B%22point%22%3A%22bucket%22%2C%22series%22%3A0%2C%22bucket%22%3A%222026-10-05T00%3A00%3A00%22%7D%2C%22limit%22%3A50%2C%22offset%22%3A0%7D
