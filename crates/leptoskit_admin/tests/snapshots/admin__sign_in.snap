    div [code]
      div [code-line]
        span [code-text]
          "impl auth::Roles for User {"
      div [code-line]
        span [code-text]
          "async fn roles(db: &Db, account: Id<Account>) -> auth::Result<Vec<String>> {"
      div [code-line]
        span [code-text]
          "match User::find(db, account).await? {"
      div [code-line]
        span [code-text]
          "Some(user) if user.admin => Ok(vec![\"admin\".into()]),"
      div [code-line]
        span [code-text]
          "_ => Ok(Vec::new()),"
      div [code-line]
        span [code-text]
          "}"
      div [code-line]
        span [code-text]
          "}"
      div [code-line]
        span [code-text]
          "}"
      button [copy] label="Copy as Rust"
        "Copy"
    "Give the account the role there, then sign in again. The admin reads roles at sign-in, so a change applies from the next one."
