---
source: crates/leptoskit_admin/tests/analytics.rs
expression: screen(html)
---
main [main]
  div [notice] role=status
  div [live-refresh]
    "signed_up → note_created retention"
    "Retention · new · updates live"
    button [add-to-dashboard]
      "Add to dashboard"
