//! Unmatched URLs.

use leptoskit::prelude::Element;
use leptoskit::prelude::Text;
use leptoskit::prelude::View;
use leptoskit::prelude::component;

/// Anything the router does not match.
#[component]
pub fn Page() -> Element {
	View()
		.class("flex-1 items-center justify-center gap-2 bg-slate-950 p-6")
		.child(Text("Not found").class("text-2xl font-semibold text-white"))
		.child(Text("That screen is not in this app.").class("text-base text-slate-300"))
}
