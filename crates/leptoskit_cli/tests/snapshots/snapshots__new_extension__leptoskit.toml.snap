---
source: crates/leptoskit_cli/tests/snapshots.rs
expression: contents
---
#:schema https://leptoskit.dev/schemas/leptoskit.v0.schema.json

schema_version = 0

[app]
name = "snapshotted"
version = "0.1.0"
default_platform = "web"
platforms = [
    "web",
    "ios",
    "android",
    "macos",
    "windows",
    "linux",
    "extension",
]
render = "ssr"

[serve]
address = "127.0.0.1"
port = 3000
probes = true

[build]
backend = true
client_package = "snapshotted_app"
features = []
rustflags = []

[bundle]
optimize = "fast"
split = true
wasm_opt = true
precompress = true

[native]
update_contract = "mobile-v1"
package_id = "com.leptoskit.snapshotted"
viewport_width = 390.0
viewport_height = 844.0

[codepush]
enabled = false
allow_http = false
server = ""
channel = "production"
mandatory = false
staging_dir = "codepush"
public_keys = []

[rpc]
servers = []
exclude = []
include_internal = false
targets = []

[rpc.jobs]
workers = 4
poll_seconds = 5
retention_days = 7

[rpc.jobs.queues]

[extension]
name = "snapshotted"
browsers = [
    "chromium",
    "firefox",
]

[extension.popup]
route = "/"

[extension.background]
events = ["runtime.message"]

[extension.firefox]
id = "snapshotted@example.com"
data_collection = ["none"]

[[plugins]]
name = "router"
leptos = false

[plugins.options]
dir = "snapshotted_app/src/routes"

[lint]
markup = "builder"
clippy = true
exclude = []

[lint.rules]
component_attribute = "deny"
markup_style = "deny"
redundant_view = "warn"
spacer_view = "warn"
children_last = "warn"
image_label = "warn"
color_literal = "allow"
