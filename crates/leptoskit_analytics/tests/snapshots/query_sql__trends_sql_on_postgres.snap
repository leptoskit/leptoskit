---
source: crates/leptoskit_analytics/tests/query_sql.rs
expression: "sql_of(&trends(false, false, None), Dialect::Postgres)"
---
-- trends: signed_up
SELECT to_char(date_trunc('day', "events"."timestamp" + $9::interval), 'YYYY-MM-DD"T"HH24:MI:SS') AS "bucket", count(distinct coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id")) AS "value" FROM "events" WHERE "events"."timestamp" >= $1 AND "events"."timestamp" < $2 AND "events"."name" = $3 AND (("events"."properties"::jsonb -> $4)) = $5::jsonb AND COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")) IN (SELECT "pp"."id" FROM "persons" "pp" WHERE (("pp"."properties"::jsonb #>> ARRAY[$6::text])) IS NOT NULL) AND "events"."session_id" IN (SELECT "s"."id" FROM "sessions" "s" WHERE instr(lower("s"."browser"), lower($7)) > 0) AND "events"."distinct_id" NOT IN ($8) GROUP BY "bucket" ORDER BY "bucket" LIMIT 20000

-- trends: every event
SELECT to_char(date_trunc('day', "events"."timestamp" + $8::interval), 'YYYY-MM-DD"T"HH24:MI:SS') AS "bucket", count(distinct coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id")) AS "value" FROM "events" WHERE "events"."timestamp" >= $1 AND "events"."timestamp" < $2 AND (("events"."properties"::jsonb -> $3)) = $4::jsonb AND COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")) IN (SELECT "pp"."id" FROM "persons" "pp" WHERE (("pp"."properties"::jsonb #>> ARRAY[$5::text])) IS NOT NULL) AND "events"."session_id" IN (SELECT "s"."id" FROM "sessions" "s" WHERE instr(lower("s"."browser"), lower($6)) > 0) AND "events"."distinct_id" NOT IN ($7) GROUP BY "bucket" ORDER BY "bucket" LIMIT 20000
