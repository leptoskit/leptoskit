---
source: crates/leptoskit_analytics/tests/query_sql.rs
expression: "sql_of(&query, Dialect::Sqlite)"
---
-- actors in bucket
SELECT DISTINCT COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")) AS "person" FROM "events" WHERE "events"."timestamp" >= ?1 AND "events"."timestamp" < ?2 AND "events"."name" = ?3 AND (json_extract("events"."properties", ?4)) = ?5 AND COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")) IN (SELECT "pp"."id" FROM "persons" "pp" WHERE (json_extract("pp"."properties", ?6)) IS NOT NULL) AND "events"."session_id" IN (SELECT "s"."id" FROM "sessions" "s" WHERE instr(lower("s"."browser"), lower(?7)) > 0) AND "events"."distinct_id" NOT IN (?8) AND strftime('%Y-%m-%dT00:00:00', "events"."timestamp", ?9) = ?10 AND COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")) IS NOT NULL AND json_extract("events"."properties", ?11) = ?12 LIMIT 100000
