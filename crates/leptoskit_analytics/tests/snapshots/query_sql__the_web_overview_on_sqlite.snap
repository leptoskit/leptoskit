---
source: crates/leptoskit_analytics/tests/query_sql.rs
expression: "sql_of(&web(true), Dialect::Sqlite)"
---
-- web overview
SELECT count(*) AS "sessions", sum("s"."pageview_count") AS "pageviews", count(distinct coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "s"."distinct_id"), "s"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "s"."distinct_id")), "s"."distinct_id")) AS "visitors", sum(CASE WHEN "s"."is_bounce" THEN 1 ELSE 0 END) AS "bounces", sum("s"."duration_ms") AS "duration" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3

-- web overview previous
SELECT count(*) AS "sessions", sum("s"."pageview_count") AS "pageviews", count(distinct coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "s"."distinct_id"), "s"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "s"."distinct_id")), "s"."distinct_id")) AS "visitors", sum(CASE WHEN "s"."is_bounce" THEN 1 ELSE 0 END) AS "bounces", sum("s"."duration_ms") AS "duration" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3

-- web overview pages
SELECT json_extract("events"."properties", ?5) AS "page", count(*) AS "count" FROM "events" WHERE "events"."timestamp" >= ?1 AND "events"."timestamp" < ?2 AND "events"."name" = ?3 AND "events"."session_id" IN (SELECT "s"."id" FROM "sessions" "s" WHERE "s"."device_type" = ?4) GROUP BY "page" ORDER BY "count" DESC, "page" LIMIT 5

-- web overview tables
SELECT "dimension", "value", "count" FROM (SELECT 'entry_pathname' AS "dimension", "s"."entry_pathname" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."entry_pathname" <> '' GROUP BY "s"."entry_pathname" UNION ALL SELECT 'exit_pathname' AS "dimension", "s"."exit_pathname" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."exit_pathname" <> '' GROUP BY "s"."exit_pathname" UNION ALL SELECT 'referrer_domain' AS "dimension", "s"."referrer_domain" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."referrer_domain" <> '' GROUP BY "s"."referrer_domain" UNION ALL SELECT 'channel' AS "dimension", "s"."channel" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."channel" <> '' GROUP BY "s"."channel" UNION ALL SELECT 'utm_source' AS "dimension", "s"."utm_source" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."utm_source" <> '' GROUP BY "s"."utm_source" UNION ALL SELECT 'utm_campaign' AS "dimension", "s"."utm_campaign" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."utm_campaign" <> '' GROUP BY "s"."utm_campaign" UNION ALL SELECT 'device_type' AS "dimension", "s"."device_type" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."device_type" <> '' GROUP BY "s"."device_type" UNION ALL SELECT 'browser' AS "dimension", "s"."browser" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."browser" <> '' GROUP BY "s"."browser" UNION ALL SELECT 'os' AS "dimension", "s"."os" AS "value", count(*) AS "count" FROM "sessions" "s" WHERE "s"."first_timestamp" >= ?1 AND "s"."first_timestamp" < ?2 AND "s"."device_type" = ?3 AND "s"."os" <> '' GROUP BY "s"."os") AS "tables" ORDER BY "dimension", "count" DESC, "value" LIMIT 45
