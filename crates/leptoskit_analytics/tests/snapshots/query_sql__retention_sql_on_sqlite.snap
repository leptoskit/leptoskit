---
source: crates/leptoskit_analytics/tests/query_sql.rs
expression: "sql_of(&retention(), Dialect::Sqlite)"
---
-- retention cohort
SELECT coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id") AS "person", strftime('%Y-%m-%dT00:00:00', "events"."timestamp", ?4, '-6 days', 'weekday 1') AS "period" FROM "events" WHERE "events"."timestamp" >= ?1 AND "events"."timestamp" < ?2 AND "events"."name" = ?3 GROUP BY "person", "period" ORDER BY "person", "period" LIMIT 100000

-- retention returns
SELECT coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id") AS "person", strftime('%Y-%m-%dT00:00:00', "events"."timestamp", ?4, '-6 days', 'weekday 1') AS "period" FROM "events" WHERE "events"."timestamp" >= ?1 AND "events"."timestamp" < ?2 AND "events"."name" = ?3 GROUP BY "person", "period" ORDER BY "person", "period" LIMIT 100000
