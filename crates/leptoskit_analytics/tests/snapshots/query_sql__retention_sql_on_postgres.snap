---
source: crates/leptoskit_analytics/tests/query_sql.rs
expression: "sql_of(&retention(), Dialect::Postgres)"
---
-- retention cohort
SELECT coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id") AS "person", min("events"."timestamp") AS "first_ever", min(CASE WHEN "events"."timestamp" >= $1 AND "events"."timestamp" < $2 THEN "events"."timestamp" END) AS "entered" FROM "events" WHERE "events"."timestamp" >= $1 AND "events"."timestamp" < $2 AND "events"."name" = $3 GROUP BY "person" ORDER BY "person" LIMIT 100000

-- retention returns
SELECT coalesce(COALESCE((SELECT "po"."person_id" FROM "person_overrides" "po" WHERE "po"."distinct_id" = "events"."distinct_id"), "events"."person_id", (SELECT "pdi"."person_id" FROM "person_distinct_ids" "pdi" WHERE "pdi"."distinct_id" = "events"."distinct_id")), "events"."distinct_id") AS "person", to_char(date_trunc('week', "events"."timestamp" + $4::interval), 'YYYY-MM-DD"T"HH24:MI:SS') AS "period" FROM "events" WHERE "events"."timestamp" >= $1 AND "events"."timestamp" < $2 AND "events"."name" = $3 GROUP BY "person", "period" ORDER BY "person", "period" LIMIT 100000
